{
  "name": "abada-oc-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "ng build --configuration production && ng deploy",
    "predeploy": "node scripts/predeploy-check.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.1.1",
    "@angular/compiler": "21.1.1",
    "@angular/core": "21.1.1",
    "@angular/forms": "21.1.1",
    "@angular/platform-browser": "21.1.1",
    "@angular/platform-server": "21.1.1",
    "@angular/router": "21.1.1",
    "@angular/ssr": "21.1.1",
    "@emailjs/browser": "^4.4.1",
    "rxjs": "~7.8.0",
    "signature_pad": "^5.1.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.1.1",
    "@angular/cli": "21.1.1",
    "@angular/compiler-cli": "21.1.1",
    "angular-cli-ghpages": "^3.0.3",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
